  "name": "local-agent",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway"
  ],
  "remoteEnv": {
    "LOCAL_AGENT_OLLAMA_BASE_URL": "http://host.docker.internal:11434"
  },
  "postCreateCommand": "pip install -e ."
}
